{
  "name": "@patwoodman/dsh-sdlc-flow-ui",
  "version": "0.4.0-beta.25",
  "type": "module",
  "description": "SDLC orchestrator web UI: config editor, task board, and side-by-side review (sdlc-web profile only).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ../../scripts/build-ui.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-client-ui",
    "url": "git+https://github.com/pwoodman/dsh-sdlc.git"
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwoodman/dsh-sdlc",
  "bugs": {
    "url": "https://github.com/pwoodman/dsh-sdlc/issues"
  },
  "dependencies": {
    "@patwoodman/dsh-sdlc-flow-cli": "0.4.0-beta.25",
    "@patwoodman/dsh-sdlc-flow-core": "0.4.0-beta.25"
  }
}

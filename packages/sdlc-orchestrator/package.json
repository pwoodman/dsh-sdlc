{
  "name": "@sdlc/orchestrator",
  "version": "0.4.0-beta.2",
  "type": "module",
  "description": "SDLC Orchestrator lead-profile bundle: task engine, tools, role presets, and web UI in one install.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ./build.cjs",
    "prepack": "node ./build.cjs",
    "prepare": "node ./build.cjs"
  },
  "dependencies": {
    "@sdlc/orchestrator-core": "0.4.0-beta.2",
    "@sdlc/orchestrator-tools": "0.4.0-beta.2",
    "@sdlc/orchestrator-presets": "0.4.0-beta.2",
    "@sdlc/orchestrator-ui": "0.4.0-beta.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-orchestrator"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

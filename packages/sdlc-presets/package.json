{
  "name": "@patwoodman/dsh-sdlc-flow-presets",
  "version": "1.3.0",
  "type": "module",
  "description": "26 dsh-agent-preset rows — one per SDLC role (patch declares them; no host code).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./roles": "./lib/roles.js",
    "./plugin": "./lib/plugin.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "gen": "node ../../scripts/gen-presets.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-presets",
    "url": "git+https://github.com/pwoodman/dsh-sdlc.git"
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwoodman/dsh-sdlc",
  "bugs": {
    "url": "https://github.com/pwoodman/dsh-sdlc/issues"
  },
  "dependencies": {
    "@patwoodman/dsh-sdlc-flow-guard": "1.3.0"
  }
}

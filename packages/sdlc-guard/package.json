{
  "name": "@patwoodman/dsh-sdlc-flow-guard",
  "version": "0.4.0-beta.13",
  "type": "module",
  "description": "Worker-side enforcement only: tools/pre-execute + fs/* deciders. Never installed into the lead profile.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./plugin": "./lib/plugin.js",
    "./glob": "./lib/glob.js",
    "./schema.json": "./schema/path-policy.schema.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "schema",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-guard",
    "url": "git+https://github.com/pwoodman/dsh-sdlc.git"
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwoodman/dsh-sdlc",
  "bugs": {
    "url": "https://github.com/pwoodman/dsh-sdlc/issues"
  }
}

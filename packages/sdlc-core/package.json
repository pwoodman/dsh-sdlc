{
  "name": "@patwoodman/dsh-sdlc-flow-core",
  "version": "1.2.9",
  "type": "module",
  "description": "Host services (tasks, scheduler, router, verifier, integration, evidence, escalation, worker-mgr). NEVER installed into a worker profile.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js",
    "./complexity": "./lib/complexity/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-core",
    "url": "git+https://github.com/pwoodman/dsh-sdlc.git"
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwoodman/dsh-sdlc",
  "bugs": {
    "url": "https://github.com/pwoodman/dsh-sdlc/issues"
  },
  "dependencies": {
    "@patwoodman/dsh-sdlc-flow-guard": "1.2.9"
  }
}

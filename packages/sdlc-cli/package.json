{
  "name": "@sdlc/orchestrator-cli",
  "version": "0.4.0-beta.2",
  "type": "module",
  "description": "The `sdlc` executable: a deterministic control plane over .sdlc/ (no model calls).",
  "bin": {
    "sdlc": "./bin/sdlc.mjs"
  },
  "main": "src/cli.mjs",
  "files": [
    "src",
    "bin",
    "locale/*.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ./build.cjs",
    "prepack": "node ./build.cjs",
    "prepare": "node ./build.cjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-cli"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

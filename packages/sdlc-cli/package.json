{
  "name": "@patwoodman/dsh-sdlc-flow-cli",
  "version": "1.2.9",
  "type": "module",
  "description": "The `sdlc` executable: a deterministic control plane over .sdlc/ (no model calls).",
  "bin": {
    "sdlc": "./bin/sdlc.mjs"
  },
  "main": "lib/cli.mjs",
  "files": [
    "lib",
    "bin",
    "locale/*.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@patwoodman/dsh-sdlc-flow-core": "1.2.9"
  },
  "exports": {
    ".": "./lib/cli.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/sdlc-cli",
    "url": "git+https://github.com/pwoodman/dsh-sdlc.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwoodman/dsh-sdlc",
  "bugs": {
    "url": "https://github.com/pwoodman/dsh-sdlc/issues"
  }

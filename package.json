{
  "name": "dsh-plugin-sdlc",
  "version": "0.4.0-beta.16",
  "private": true,
  "type": "module",
  "description": "Universal SDLC Orchestrator — a DeepSeek Harness plugin suite (spec v3).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "//": "The build is a zero-dependency src/ → lib/ artifact step (see scripts/build.mjs and SDLC_IMPLEMENTATION_NOTES.md, deviation D0). Test layers map 1:1 onto spec K.2 layers L2–L7. gate:P and gate:M0 require no LLM and no network; gate:M1..M8 are deterministic and use the sdlc-mock-llm provider.",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-ui.mjs && node scripts/fold-meta.mjs",
    "build:check": "node scripts/build.mjs --check && node scripts/build-ui.mjs --check",
    "gen:presets": "node scripts/gen-presets.mjs",
    "gen:presets:check": "node scripts/gen-presets.mjs --check",
    "gen:bundle-patch": "node scripts/gen-bundle-patch.mjs",
    "gen:bundle-patch:check": "node scripts/gen-bundle-patch.mjs --check",
    "fold:meta": "node scripts/fold-meta.mjs",
    "gen:check": "node scripts/gen-presets.mjs --check && node scripts/gen-bundle-patch.mjs --check && node scripts/bump-version.mjs --check && node scripts/set-repository.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "install:local": "node scripts/install-local.mjs",
    "release:build": "node scripts/build-release.mjs",
    "set-scope": "node scripts/set-scope.mjs",
    "set-repository": "node scripts/set-repository.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "validate:platform": "node scripts/validate-platform.mjs",
    "validate:m0": "node scripts/validate-m0.mjs",
    "gate:P": "node scripts/validate-platform.mjs --json .validation/gate-P.json",
    "gate:M0": "node scripts/validate-m0.mjs --json .validation/gate-M0.json",
    "gate:M1": "node scripts/validate-m1.mjs --json .validation/gate-M1.json",
    "gate:M2": "node scripts/validate-m2.mjs --json .validation/gate-M2.json",
    "gate:M3": "node scripts/validate-m3.mjs --json .validation/gate-M3.json",
    "gate:M4": "node scripts/validate-m4.mjs --json .validation/gate-M4.json",
    "gate:M5": "node scripts/validate-m5.mjs --json .validation/gate-M5.json",
    "gate:M6": "node scripts/validate-m6.mjs --json .validation/gate-M6.json",
    "gate:M7": "node scripts/validate-m7.mjs --json .validation/gate-M7.json",
    "gate:M8": "node scripts/validate-m8.mjs --json .validation/gate-M8.json",
    "gate:Q": "node scripts/validate-coverage.mjs --json .validation/gate-Q.json",
    "gate:current": "node scripts/validate-gates.mjs",
    "gate": "npm run gate:P && npm run gate:M0",
    "eval": "node eval/run.mjs --executor simulate --repeats 3",
    "eval:report": "node eval/report.mjs --allow-simulate",
    "eval:test": "node --test tests/unit/eval-stats.test.mjs tests/unit/eval-manifest.test.mjs tests/unit/eval-metrics.test.mjs tests/unit/eval-report.test.mjs tests/unit/eval-usage.test.mjs tests/unit/eval-zstd-frames.test.mjs tests/unit/eval-session.test.mjs tests/unit/eval-live-safety.test.mjs tests/unit/eval-harness-hardening.test.mjs tests/integration/eval-pipeline.test.mjs",
    "eval:live": "node eval/run.mjs --executor dsh --live --repeats 5",
    "test:unit": "node --test 'tests/unit/**/*.test.mjs'",
    "test:contract": "node --test 'tests/contract/**/*.test.mjs'",
    "test:integration": "node --test 'tests/integration/**/*.test.mjs'",
    "test:fault": "node --test 'tests/fault/**/*.test.mjs'",
    "test:adversarial": "node --test 'tests/adversarial/**/*.test.mjs'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.mjs'",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:adversarial && npm run test:fault",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=packages/*/src/** 'tests/unit/**/*.test.mjs' 'tests/contract/**/*.test.mjs' 'tests/integration/**/*.test.mjs' 'tests/fault/**/*.test.mjs' 'tests/adversarial/**/*.test.mjs'",
    "test:e2e-live": "node --test 'tests/e2e/**/*.test.mjs' --test-name-pattern=live"
  },
  "devDependencies": {}
}

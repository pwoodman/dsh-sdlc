{
  "name": "sdlc-worker",
  "role": "headless-worker",
  "template": "headless",
  "bundles": [
    "@patwoodman/dsh-sdlc-flow-guard",
    "@patwoodman/dsh-sdlc-flow-tools"
  ],
  "mustNotContain": [
    "@patwoodman/dsh-sdlc-flow-core"
  ],
  "capabilities": {
    "slashCommands": false,
    "approvals": false,
    "longLived": false,
    "holdsInstanceLock": false
  },
  "note": "Errata E6: sdlc-core must never be installed here — it would start a second scheduler and a second writer against sdlc.db."
}
